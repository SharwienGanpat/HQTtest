<odoo>
    <record id="view_move_form_currency_recalculate_hidden_field" model="ir.ui.view">
        <field name="name">account.move.form.currency.recalculate.hidden.field</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="previous_currency_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>