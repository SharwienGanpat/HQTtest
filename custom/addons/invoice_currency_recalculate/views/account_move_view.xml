<odoo>
    <record id="view_move_form_currency_recalculate_button" model="ir.ui.view">
        <field name="name">account.move.form.currency.recalculate.button</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_recalculate_currency_prices"
                        type="object"
                        string="Recalculate Currency Prices"/>
            </xpath>
        </field>
    </record>
</odoo>