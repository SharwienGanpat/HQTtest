<odoo>

    <record id="view_invoice_currency_split_list" model="ir.ui.view">
        <field name="name">invoice.currency.split.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Invoice Currency Split Report" create="false" edit="false" delete="false">
                <field name="name" string="Number"/>
                <field name="partner_id" string="Customer"/>
                <field name="invoice_date" string="Invoice Date"/>
                <field name="invoice_date_due" string="Due Date"/>

                <field name="amount_untaxed_usd" sum="Tax Excluded USD"/>
                <field name="amount_untaxed_srd" sum="Tax Excluded SRD"/>

                <field name="amount_total_usd" sum="Total USD"/>
                <field name="amount_total_srd" sum="Total SRD"/>

                <field name="payment_state" string="Status"/>
            </list>
        </field>
    </record>

    <record id="view_invoice_currency_split_search" model="ir.ui.view">
        <field name="name">invoice.currency.split.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search string="Invoice Currency Split Report">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="invoice_date"/>

                <filter string="Invoices"
                        name="customer_invoices"
                        domain="[('move_type', '=', 'out_invoice')]"/>

                <filter string="Posted"
                        name="posted"
                        domain="[('state', '=', 'posted')]"/>

                <filter string="Draft"
                        name="draft"
                        domain="[('state', '=', 'draft')]"/>

                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_customer" context="{'group_by': 'partner_id'}"/>
                    <filter string="Invoice Date" name="group_invoice_date" context="{'group_by': 'invoice_date'}"/>
                    <filter string="Currency" name="group_currency" context="{'group_by': 'currency_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'payment_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_invoice_currency_split_report" model="ir.actions.act_window">
        <field name="name">Invoice Currency Split Report</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_invoice_currency_split_list"/>
        <field name="search_view_id" ref="view_invoice_currency_split_search"/>
        <field name="domain">[('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'search_default_customer_invoices': 1}</field>
    </record>

    <menuitem id="menu_invoice_currency_split_report"
              name="Invoice Currency Split Report"
              parent="account.menu_finance_reports"
              action="action_invoice_currency_split_report"
              sequence="90"/>

</odoo>