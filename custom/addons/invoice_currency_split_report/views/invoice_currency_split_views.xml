<odoo>

    <record id="view_invoice_currency_split_list" model="ir.ui.view">
        <field name="name">invoice.currency.split.list</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <list string="Invoice Currency Split Report" create="false" edit="false" delete="false">

                <field name="date" string="Date" optional="show"/>
                <field name="invoice_date_due" string="Due Date" optional="show"/>
                <field name="move_id" string="Journal Entry" optional="show"/>
                <field name="partner_id" string="Partner" optional="show"/>

                <field name="product_name_export" string="Product" optional="show"/>
                <field name="quantity" string="Quantity" optional="show"/>

                <field name="amount_untaxed_usd" string="Tax Excluded USD" sum="Tax Excluded USD" optional="show"/>
                <field name="amount_untaxed_srd" string="Tax Excluded SRD" sum="Tax Excluded SRD" optional="show"/>

                <field name="amount_total_usd" string="Total USD" sum="Total USD" optional="show"/>
                <field name="amount_total_srd" string="Total SRD" sum="Total SRD" optional="show"/>

                <field name="invoice_payment_state" string="Status" optional="show"/>

                <!-- Optional fields available from the right-side column selector -->
                <field name="currency_id" string="Currency" optional="hide"/>
                <field name="product_id" string="Product Record" optional="hide"/>
                <field name="price_unit" string="Unit Price" optional="hide"/>
                <field name="price_subtotal" string="Untaxed Amount in Currency" optional="hide"/>
                <field name="price_total" string="Total in Currency" optional="hide"/>

            </list>
        </field>
    </record>

    <record id="view_invoice_currency_split_search" model="ir.ui.view">
        <field name="name">invoice.currency.split.search</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <search string="Invoice Currency Split Report">

                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="product_name_export"/>
                <field name="product_id"/>
                <field name="date"/>

                <filter string="Invoices"
                        name="customer_invoices"
                        domain="[('move_id.move_type', '=', 'out_invoice')]"/>

                <filter string="Posted"
                        name="posted"
                        domain="[('move_id.state', '=', 'posted')]"/>

                <filter string="Draft"
                        name="draft"
                        domain="[('move_id.state', '=', 'draft')]"/>

                <group expand="0" string="Group By">
                    <filter string="Product"
                            name="group_product"
                            context="{'group_by': 'product_name_export'}"/>

                    <filter string="Customer"
                            name="group_customer"
                            context="{'group_by': 'partner_id'}"/>

                    <filter string="Invoice Date"
                            name="group_invoice_date"
                            context="{'group_by': 'date'}"/>

                    <filter string="Currency"
                            name="group_currency"
                            context="{'group_by': 'currency_id'}"/>

                    <filter string="Status"
                            name="group_status"
                            context="{'group_by': 'invoice_payment_state'}"/>
                </group>

            </search>
        </field>
    </record>

    <record id="action_invoice_currency_split_report" model="ir.actions.act_window">
        <field name="name">Invoice Currency Split Report</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_invoice_currency_split_list"/>
        <field name="search_view_id" ref="view_invoice_currency_split_search"/>
        <field name="domain">[
            ('move_id.move_type', '=', 'out_invoice'),
            ('product_id', '!=', False),
            ('display_type', 'not in', ('line_section', 'line_note'))
        ]</field>
        <field name="context">
            {
                'search_default_customer_invoices': 1,
                'search_default_group_product': 1
            }
        </field>
    </record>

    <menuitem id="menu_invoice_currency_split_report"
              name="Invoice Currency Split Report"
              parent="account.menu_finance_reports"
              action="action_invoice_currency_split_report"
              sequence="90"/>

</odoo>