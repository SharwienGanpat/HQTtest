<odoo>

    <record id="view_invoice_product_report_wizard_form" model="ir.ui.view">
        <field name="name">invoice.product.report.wizard.form</field>
        <field name="model">invoice.product.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Invoice Product Currency Report">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>

                <footer>
                    <button name="action_generate_report"
                            string="Apply"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_invoice_product_report_wizard" model="ir.actions.act_window">
        <field name="name">Invoice Product Currency Report</field>
        <field name="res_model">invoice.product.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_invoice_product_report_wizard_form"/>
        <field name="target">new</field>
    </record>

    <record id="view_invoice_product_currency_report_result_list" model="ir.ui.view">
        <field name="name">invoice.product.currency.report.result.list</field>
        <field name="model">invoice.product.currency.report.result</field>
        <field name="arch" type="xml">
            <list string="Invoice Product Currency Report" create="false" edit="false" delete="false">
                <field name="product_name" string="Product" optional="show"/>
                <field name="quantity" string="Quantity" sum="Quantity" optional="show"/>

                <field name="purchase_cost" string="Purchase Cost" optional="hide"/>

                <field name="amount_untaxed_usd" string="Tax Excluded USD" sum="Tax Excluded USD" optional="hide"/>
                <field name="amount_untaxed_srd" string="Tax Excluded SRD" sum="Tax Excluded SRD" optional="hide"/>

                <field name="amount_total_usd" string="Total USD" sum="Total USD" optional="show"/>
                <field name="amount_total_srd" string="Total SRD" sum="Total SRD" optional="show"/>

                <field name="date_from" string="From Date" optional="hide"/>
                <field name="date_to" string="To Date" optional="hide"/>
                <field name="product_id" string="Product Record" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_invoice_product_currency_report_result_search" model="ir.ui.view">
        <field name="name">invoice.product.currency.report.result.search</field>
        <field name="model">invoice.product.currency.report.result</field>
        <field name="arch" type="xml">
            <search string="Invoice Product Currency Report">
                <field name="product_name"/>
                <field name="product_id"/>
            </search>
        </field>
    </record>

    <record id="action_invoice_product_currency_report_result" model="ir.actions.act_window">
        <field name="name">Invoice Product Currency Report</field>
        <field name="res_model">invoice.product.currency.report.result</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_invoice_product_currency_report_result_list"/>
        <field name="search_view_id" ref="view_invoice_product_currency_report_result_search"/>
    </record>

    <menuitem id="menu_invoice_product_currency_report"
              name="Invoice Product Currency Report"
              parent="account.menu_finance_reports"
              action="action_invoice_product_report_wizard"
              sequence="110"/>

</odoo>