<odoo>

    <record id="view_invoice_product_currency_report_list" model="ir.ui.view">
        <field name="name">invoice.product.currency.report.list</field>
        <field name="model">invoice.product.currency.report</field>
        <field name="arch" type="xml">
            <list string="Invoice Product Currency Report" create="false" edit="false" delete="false">
                <field name="product_name" string="Product" optional="show"/>
                <field name="quantity" string="Quantity" sum="Quantity" optional="show"/>

                <field name="amount_untaxed_usd" string="Tax Excluded USD" sum="Tax Excluded USD" optional="show"/>
                <field name="amount_untaxed_srd" string="Tax Excluded SRD" sum="Tax Excluded SRD" optional="show"/>

                <field name="amount_total_usd" string="Total USD" sum="Total USD" optional="show"/>
                <field name="amount_total_srd" string="Total SRD" sum="Total SRD" optional="show"/>

                <field name="invoice_date" string="Invoice Date" optional="hide"/>
                <field name="due_date" string="Due Date" optional="hide"/>
                <field name="partner_id" string="Customer" optional="hide"/>
                <field name="commercial_partner_id" string="Commercial Entity" optional="hide"/>
                <field name="product_categ_id" string="Product Category" optional="hide"/>
                <field name="currency_id" string="Currency" optional="hide"/>
                <field name="company_id" string="Company" optional="hide"/>
                <field name="journal_id" string="Journal" optional="hide"/>
                <field name="invoice_user_id" string="Salesperson" optional="hide"/>
                <field name="team_id" string="Sales Team" optional="hide"/>
                <field name="state" string="Invoice Status" optional="hide"/>
                <field name="payment_state" string="Payment Status" optional="hide"/>
                <field name="product_id" string="Product Record" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_invoice_product_currency_report_search" model="ir.ui.view">
        <field name="name">invoice.product.currency.report.search</field>
        <field name="model">invoice.product.currency.report</field>
        <field name="arch" type="xml">
            <search string="Invoice Product Currency Report">
                <field name="product_name"/>
                <field name="product_id"/>
                <field name="invoice_date"/>
                <field name="due_date"/>
                <field name="partner_id"/>
                <field name="commercial_partner_id"/>
                <field name="product_categ_id"/>
                <field name="currency_id"/>
                <field name="company_id"/>
                <field name="journal_id"/>
                <field name="invoice_user_id"/>
                <field name="team_id"/>
                <field name="state"/>
                <field name="payment_state"/>

                <filter string="Posted"
                        name="posted"
                        domain="[('state', '=', 'posted')]"/>

                <filter string="Draft"
                        name="draft"
                        domain="[('state', '=', 'draft')]"/>

                <filter string="Paid"
                        name="paid"
                        domain="[('payment_state', '=', 'paid')]"/>

                <filter string="Not Paid"
                        name="not_paid"
                        domain="[('payment_state', '=', 'not_paid')]"/>

                <filter string="USD"
                        name="currency_usd"
                        domain="[('currency_id.name', '=', 'USD')]"/>

                <filter string="SRD"
                        name="currency_srd"
                        domain="[('currency_id.name', '=', 'SRD')]"/>

                <group expand="0" string="Group By">
                    <filter string="Product"
                            name="group_product"
                            context="{'group_by': 'product_id'}"/>

                    <filter string="Product Category"
                            name="group_product_category"
                            context="{'group_by': 'product_categ_id'}"/>

                    <filter string="Customer"
                            name="group_customer"
                            context="{'group_by': 'partner_id'}"/>

                    <filter string="Commercial Entity"
                            name="group_commercial_partner"
                            context="{'group_by': 'commercial_partner_id'}"/>

                    <filter string="Invoice Date"
                            name="group_invoice_date"
                            context="{'group_by': 'invoice_date'}"/>

                    <filter string="Due Date"
                            name="group_due_date"
                            context="{'group_by': 'due_date'}"/>

                    <filter string="Currency"
                            name="group_currency"
                            context="{'group_by': 'currency_id'}"/>

                    <filter string="Company"
                            name="group_company"
                            context="{'group_by': 'company_id'}"/>

                    <filter string="Journal"
                            name="group_journal"
                            context="{'group_by': 'journal_id'}"/>

                    <filter string="Salesperson"
                            name="group_salesperson"
                            context="{'group_by': 'invoice_user_id'}"/>

                    <filter string="Sales Team"
                            name="group_sales_team"
                            context="{'group_by': 'team_id'}"/>

                    <filter string="Invoice Status"
                            name="group_invoice_status"
                            context="{'group_by': 'state'}"/>

                    <filter string="Payment Status"
                            name="group_payment_status"
                            context="{'group_by': 'payment_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_invoice_product_currency_report" model="ir.actions.act_window">
        <field name="name">Invoice Product Currency Report</field>
        <field name="res_model">invoice.product.currency.report</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_invoice_product_currency_report_list"/>
        <field name="search_view_id" ref="view_invoice_product_currency_report_search"/>
    </record>

    <menuitem id="menu_invoice_product_currency_report"
              name="Invoice Product Currency Report"
              parent="account.menu_finance_reports"
              action="action_invoice_product_currency_report"
              sequence="110"/>

</odoo>