<odoo>
    <record id="product_template_form_allowed_companies" model="ir.ui.view">
        <field name="name">product.template.form.allowed.companies</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='barcode']" position="after">
                <field name="product_price_currency_id"/>
                <field name="allowed_company_ids" widget="many2many_tags"/>
            </xpath>

            <!-- Sales Price -->
            <xpath expr="//field[@name='list_price']" position="replace">
                <field name="list_price"
                       widget="monetary"
                       options="{'currency_field': 'product_price_currency_id'}"/>
            </xpath>

            <!-- Cost -->
            <xpath expr="//field[@name='standard_price']" position="replace">
                <field name="standard_price"
                       widget="monetary"
                       options="{'currency_field': 'product_price_currency_id'}"/>
            </xpath>

        </field>
    </record>

    <record id="product_template_kanban_currency_text" model="ir.ui.view">
        <field name="name">product.template.kanban.currency.text</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="replace">
                <field name="display_list_price"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_currency_text" model="ir.ui.view">
        <field name="name">product.template.tree.currency.text</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="replace">
                <field name="display_list_price" string="Sales Price"/>
            </xpath>
            <xpath expr="//field[@name='standard_price']" position="replace">
                <field name="display_standard_price" string="Cost"/>
            </xpath>
        </field>
    </record>
</odoo>